
@model BTLwebdaugia.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<h1>Dashboard</h1>

<p class="muted">
    Overview of BidHub operations
</p>

<div class="metrics">

    <div class="metric">
        <div class="muted small">Users</div>
        <strong>@Model.TotalUsers</strong>
        <small>Registered accounts</small>
    </div>

    <div class="metric">
        <div class="muted small">Products</div>
        <strong>@Model.TotalProducts</strong>
        <small>Non-deleted products</small>
    </div>

    <div class="metric">
        <div class="muted small">Live auctions</div>
        <strong>@Model.LiveAuctions</strong>
        <small>Approved active sessions</small>
    </div>

    <div class="metric">
        <div class="muted small">Orders</div>
        <strong>@Model.TotalOrders</strong>
        <small>Total orders</small>
    </div>

</div>

<div class="grid" style="grid-template-columns:2fr 1fr">

    <div class="panel">

        <h3>Auction activity</h3>

        <div class="metrics">

            <div class="metric">
                <div class="muted small">
                    Pending products
                </div>

                <strong>@Model.PendingProducts</strong>

                <small>Awaiting admin review</small>
            </div>

            <div class="metric">
                <div class="muted small">
                    Live auctions
                </div>

                <strong>@Model.LiveAuctions</strong>

                <small>Currently active</small>
            </div>

        </div>

    </div>

    <div class="panel">

        <h3>Quick actions</h3>

        <p>
            <a class="btn btn-wide"
               asp-controller="Admin"
               asp-action="Products">
                Review pending listings
            </a>
        </p>

        <p>
            <a class="btn btn-wide"
               asp-controller="Admin"
               asp-action="Auctions">
                View auctions
            </a>
        </p>

        <p>
            <a class="btn btn-wide"
               asp-controller="Admin"
               asp-action="Orders">
                Review orders
            </a>
        </p>

    </div>

</div>
