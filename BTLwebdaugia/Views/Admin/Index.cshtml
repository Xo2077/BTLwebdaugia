
@model BTLwebdaugia.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<h1>@Labels["Dashboard"]</h1>

<p class="muted">
    Overview of BidHub operations
</p>

<div class="metrics">

    <div class="metric">
        <div class="muted small">@Labels["Users"]</div>
        <strong>@Model.TotalUsers</strong>
        <small>@Labels["Registered accounts"]</small>
    </div>

    <div class="metric">
        <div class="muted small">@Labels["Products"]</div>
        <strong>@Model.TotalProducts</strong>
        <small>Non-deleted products</small>
    </div>

    <div class="metric">
        <div class="muted small">@Labels["Live auctions"]</div>
        <strong>@Model.LiveAuctions</strong>
        <small>Approved active sessions</small>
    </div>

    <div class="metric">
        <div class="muted small">@Labels["Orders"]</div>
        <strong>@Model.TotalOrders</strong>
        <small>@Labels["Total orders"]</small>
    </div>

</div>

<div class="grid" style="grid-template-columns:2fr 1fr">

    <div class="panel">

        <h3>@Labels["Auction activity"]</h3>

        <div class="metrics">

            <div class="metric">
                <div class="muted small">
                    Pending products
                </div>

                <strong>@Model.PendingProducts</strong>

                <small>@Labels["Awaiting admin review"]</small>
            </div>

            <div class="metric">
                <div class="muted small">
                    @Labels["Live auctions"]
                </div>

                <strong>@Model.LiveAuctions</strong>

                <small>Currently active</small>
            </div>

        </div>

    </div>

    <div class="panel">

        <h3>@Labels["Quick actions"]</h3>

        <p>
            <a class="btn btn-wide"
               asp-controller="Admin"
               asp-action="Products">
                Review pending listings
            </a>
        </p>

        <p>
            <a class="btn btn-wide"
               asp-controller="Admin"
               asp-action="Auctions">
                View auctions
            </a>
        </p>

        <p>
            <a class="btn btn-wide"
               asp-controller="Admin"
               asp-action="Orders">
                Review orders
            </a>
        </p>

    </div>

</div>
