@model List<BTLwebdaugia.Models.Category>

@{
    ViewData["Title"] = Labels["Admin Categories"].Value;
    Layout = "_AdminLayout";
}


<h1>@Labels["Categories management"]</h1>
<partial name="_AdminListControls" />

@if (TempData["CategoryError"] != null)
{
    <p class="text-danger">
        @TempData["CategoryError"]
    </p>
}

@if (TempData["CategorySuccess"] != null)
{
    <p class="text-success">
        @TempData["CategorySuccess"]
    </p>
}

<h2>@Labels["Create new category"]</h2>

<form asp-controller="Admin"
      asp-action="CreateCategory"
      method="post">

    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>@Labels["Category name"]</label>
        <input class="field"
               name="Name" data-val="true" data-val-required="@Labels["Category name is required."]"
               maxlength="120" data-val-length="@Labels["Maximum 120 characters."]" data-val-length-max="120"
               required />
<span class="text-danger field-validation-valid" data-valmsg-for="Name" data-valmsg-replace="true"></span>
    </div>

    <div class="form-group">
        <label>@Labels["Description"]</label>
        <textarea class="field"
                  name="Description" data-val="true" data-val-length="@Labels["Maximum 1000 characters."]" data-val-length-max="1000"
                  maxlength="1000"></textarea>
<span class="text-danger field-validation-valid" data-valmsg-for="Description" data-valmsg-replace="true"></span>
    </div>

    <button class="btn btn-solid" type="submit">
        @Labels["Create category"]
    </button>
</form>

<h2>@Labels["Existing categories"]</h2>

<div class="table-shell">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>@Labels["Category information"]</th>
                <th>@Labels["Save"]</th>
                <th>@Labels["Delete"]</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var category in Model)
            {
                string formId =
                    $"edit-category-{category.CategoryId}";

                <tr>
                    <td>@category.CategoryId</td>

                    <td>
                        <form id="@formId"
                              asp-controller="Admin"
                              asp-action="UpdateCategory"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="CategoryId"
                                   value="@category.CategoryId" />

                            <input class="field"
                                   name="Name" data-val="true" data-val-required="@Labels["Category name is required."]"
                                   value="@category.Name"
                                   maxlength="120" data-val-length="@Labels["Maximum 120 characters."]" data-val-length-max="120"
                                   required />
<span class="text-danger field-validation-valid" data-valmsg-for="Name" data-valmsg-replace="true"></span>

                            <textarea class="field"
                                      name="Description" data-val="true" data-val-length="@Labels["Maximum 1000 characters."]" data-val-length-max="1000"
                                      maxlength="1000">@category.Description</textarea>
<span class="text-danger field-validation-valid" data-valmsg-for="Description" data-valmsg-replace="true"></span>
                        </form>
                    </td>

                    <td>
                        <button class="btn"
                                type="submit"
                                form="@formId">
                            @Labels["Save"]
                        </button>
                    </td>

                    <td>
                        <form asp-controller="Admin"
                              asp-action="DeleteCategory"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="categoryId"
                                   value="@category.CategoryId" />

                            <button class="btn"
                                    type="submit"
                                    data-confirm="@Labels["Delete this category?"]">
                                @Labels["Delete"]
                            </button>
                        </form>
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4">
                        @Labels["No categories available."]
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<partial name="_AdminPager" />
