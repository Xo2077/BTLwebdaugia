
@model List<BTLwebdaugia.Models.Category>

@{
    ViewData["Title"] = "Admin Categories";
    Layout = "_AdminLayout";
}

<h1>Categories management</h1>
<p class="muted">
    Categories from SQL Server. Read only.
</p>

<div class="table-shell">
    <div class="table-toolbar">
        <h3>Total categories: @Model.Count</h3>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>CATEGORY</th>
                <th>DESCRIPTION</th>
                <th>POLICY</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.CategoryId</td>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                    <td>Fixed · Read only</td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4">No categories found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
