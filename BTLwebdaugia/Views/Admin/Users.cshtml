
@model List<BTLwebdaugia.Models.User>

@{
    ViewData["Title"] = "Admin Users";
    Layout = "_AdminLayout";
}

<h1>Users management</h1>
<p class="muted">Registered accounts from SQL Server</p>

<div class="table-shell">
    <div class="table-toolbar">
        <h3>Total displayed: @Model.Count</h3>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>USERNAME</th>
                <th>EMAIL</th>
                <th>ROLE</th>
                <th>CREATED</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserId</td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td><span class="tag">@user.Role</span></td>
                    <td>@user.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC</td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">No users found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
