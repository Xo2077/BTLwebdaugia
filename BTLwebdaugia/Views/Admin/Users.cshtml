
@model List<BTLwebdaugia.Models.User>

@{
    ViewData["Title"] = Labels["Admin Users"].Value;
    Layout = "_AdminLayout";
}

<h1>@Labels["Users management"]</h1>
<partial name="_AdminListControls" />
<p class="muted">@Labels["Registered accounts from SQL Server"]</p>

<div class="table-shell">
    <div class="table-toolbar">
        <h3>Total displayed: @Model.Count</h3>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>@Labels["USERNAME"]</th>
                <th>@Labels["EMAIL"]</th>
                <th>@Labels["ROLE"]</th>
                <th>@Labels["CREATED"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserId</td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td><span class="tag">@Labels[user.Role]</span></td>
                    <td>@user.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC</td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">@Labels["No users found."]</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_AdminPager" />
