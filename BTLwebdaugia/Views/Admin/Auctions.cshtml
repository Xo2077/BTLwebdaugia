
@model List<BTLwebdaugia.Models.Auction>

@{
    ViewData["Title"] = "Admin Auctions";
    Layout = "_AdminLayout";
    var now = DateTime.UtcNow;
}

<h1>Auctions management</h1>
<p class="muted">Auction sessions from SQL Server</p>

<div class="table-shell">
    <div class="table-toolbar">
        <h3>Auctions: @Model.Count</h3>
    </div>

    <table>
        <thead>
            <tr>
                <th>AUCTION / ITEM</th>
                <th>SELLER</th>
                <th>STARTING PRICE</th>
                <th>END TIME</th>
                <th>STATUS</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var auction in Model)
            {
                string status = auction.ApprovalStatus;

                if (status == "Approved")
                {
                    status = auction.Result ??
                        (auction.StartAt > now ? "Upcoming" :
                         auction.CurrentEndAt <= now ? "Ended" :
                         "Live");
                }

                <tr>
                    <td>
                        #@auction.AuctionId
                        <strong>@auction.Product.Name</strong>
                    </td>
                    <td>@auction.Product.Seller.Username</td>
                    <td>$@auction.StartingPrice.ToString("N0")</td>
                    <td>
                        @auction.CurrentEndAt.ToString("dd/MM/yyyy HH:mm")
                        UTC
                    </td>
                    <td><span class="tag">@status</span></td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">No auctions found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
