
@model List<BTLwebdaugia.Models.Order>

@{
    ViewData["Title"] = "Admin Orders";
    Layout = "_AdminLayout";
}

<h1>@Labels["Orders management"]</h1>
<p class="muted">Order records from SQL Server</p>

<div class="table-shell">
    <div class="table-toolbar">
        <h3>Orders: @Model.Count</h3>
    </div>

    <table>
        <thead>
            <tr>
                <th>@Labels["ORDER"]</th>
                <th>@Labels["PRODUCT"]</th>
                <th>@Labels["WINNER"]</th>
                <th>@Labels["AMOUNT"]</th>
                <th>@Labels["STATUS"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>#@order.OrderId</td>
                    <td>@order.Auction.Product.Name</td>
                    <td>@order.Winner.Username</td>
                    <td>$@order.FinalAmount.ToString("N0")</td>
                    <td>
                        <span class="tag">@order.Status</span>
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">@Labels["No orders found."]</td>
                </tr>
            }
        </tbody>
    </table>
</div>
