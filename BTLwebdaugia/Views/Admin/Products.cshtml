
@model List<BTLwebdaugia.Models.Product>

@{
    ViewData["Title"] = "Admin Products";
    Layout = "_AdminLayout";

    int pending = Model.Count(p =>
        !p.IsDeleted && p.ApprovalStatus == "Pending");
}

<h1>Products management</h1>

<p class="muted">
    Product listings from SQL Server
</p>

<div class="table-shell">

    <div class="table-toolbar">
        <h3>Products: @Model.Count</h3>
        <span>Pending review: @pending</span>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID / ITEM</th>
                <th>OWNER</th>
                <th>CATEGORY</th>
                <th>STATUS</th>
                <th>REVIEW</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var product in Model)
            {
                <tr>
                    <td>
                        #@product.ProductId
                        <strong>@product.Name</strong>
                    </td>

                    <td>@product.Seller.Username</td>
                    <td>@product.Category.Name</td>

                    <td>
                        <span class="tag">
                            @(product.IsDeleted
                                ? "Deleted"
                                : product.ApprovalStatus)
                        </span>
                    </td>

                    <td>
                        @if (product.ApprovalStatus == "Rejected")
                        {
                            <span class="small">
                                @product.RejectionReason
                            </span>
                        }
                        else if (product.ApprovalStatus == "Pending"
                                 && !product.IsDeleted)
                        {
                            <span class="small">
                                Awaiting review
                            </span>
                        }
                        else
                        {
                            <span class="small">
                                @product.ApprovalStatus
                            </span>
                        }
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">
                        No products available.
                    </td>
                </tr>
            }

        </tbody>
    </table>

</div>

<div class="panel" style="margin-top:24px">
    <h3>Product review</h3>
    <p class="notice">
        Approval and rejection actions are not
        enabled in this read-only version.
    </p>
</div>
