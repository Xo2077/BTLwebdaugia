
@model List<BTLwebdaugia.Models.Product>

@{
    ViewData["Title"] = Labels["Admin Products"].Value;
    Layout = "_AdminLayout";

    int pending = Model.Count(p =>
        !p.IsDeleted && p.ApprovalStatus == "Pending");
}


@if (TempData["AdminSuccess"] != null)
{
    <p class="notice">
        @TempData["AdminSuccess"]
    </p>
}

@if (TempData["AdminError"] != null)
{
    <p class="notice text-danger">
        @TempData["AdminError"]
    </p>
}



<h1>@Labels["Products management"]</h1>
<partial name="_AdminListControls" />

@* <p class="muted">
    @Labels["Product listings from SQL Server"]
</p> *@

<div class="table-shell">

    <div class="table-toolbar">
        <h3>@Labels["Products"]: @Model.Count</h3>
        <span>@Labels["Pending review"]: @pending</span>
    </div>

    <table>
        <thead>
            <tr>
                <th>@Labels["ID / ITEM"]</th>
                <th>@Labels["OWNER"]</th>
                <th>@Labels["Category"]</th>
                <th>@Labels["STATUS"]</th>
                <th>@Labels["REVIEW"]</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var product in Model)
            {
                <tr>
                    <td>
                        #@product.ProductId
                        <strong>@product.Name</strong>
                    </td>

                    <td>@product.Seller.Username</td>
                    <td>@product.Category.Name</td>

                    <td>
                        <span class="tag">
                            @(product.IsDeleted
                                ? Labels["Deleted"].Value
                                : Labels[product.ApprovalStatus].Value)
                        </span>
                    </td>

                    <td>
                        @if (product.ApprovalStatus == "Rejected")
                        {
                            <span class="small">
                                @product.RejectionReason
                            </span>
                        }

                        else if (product.ApprovalStatus == "Pending"
                                 && !product.IsDeleted)
                        {
                            <div style="display:flex;flex-direction:column;gap:8px">

                                <form asp-controller="Admin"
                                      asp-action="ApproveProduct"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="productId"
                                           value="@product.ProductId" />

                                    <button class="btn btn-small"
                                            type="submit">
                                        @Labels["Approve"]
                                    </button>
                                </form>

                                <form asp-controller="Admin"
                                      asp-action="RejectProduct"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="productId"
                                           value="@product.ProductId" />

                                    <textarea name="reason" data-val="true" data-val-required="@Labels["Rejection reason is required (maximum 1000 characters)."]"
                                              class="field"
                                              maxlength="1000"
                                              rows="2"
                                              placeholder="@Labels["Rejection reason"]"
                                              required></textarea>
<span class="text-danger field-validation-valid" data-valmsg-for="reason" data-valmsg-replace="true"></span>

                                    <button class="btn btn-small"
                                            type="submit">
                                        @Labels["Reject"]
                                    </button>
                                </form>

                            </div>
                        }
                        else
                        {
                            <span class="small">
                                @Labels[product.ApprovalStatus]
                            </span>
                        }
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">
                        No products available.
                    </td>
                </tr>
            }

        </tbody>
    </table>

</div>



<partial name="_AdminPager" />
