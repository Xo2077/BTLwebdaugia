
@model List<BTLwebdaugia.Models.Product>

@{
    ViewData["Title"] = "Admin Products";
    Layout = "_AdminLayout";

    int pending = Model.Count(p =>
        !p.IsDeleted && p.ApprovalStatus == "Pending");
}


@if (TempData["AdminSuccess"] != null)
{
    <p class="notice">
        @TempData["AdminSuccess"]
    </p>
}

@if (TempData["AdminError"] != null)
{
    <p class="notice text-danger">
        @TempData["AdminError"]
    </p>
}



<h1>Products management</h1>

<p class="muted">
    Product listings from SQL Server
</p>

<div class="table-shell">

    <div class="table-toolbar">
        <h3>Products: @Model.Count</h3>
        <span>Pending review: @pending</span>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID / ITEM</th>
                <th>OWNER</th>
                <th>CATEGORY</th>
                <th>STATUS</th>
                <th>REVIEW</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var product in Model)
            {
                <tr>
                    <td>
                        #@product.ProductId
                        <strong>@product.Name</strong>
                    </td>

                    <td>@product.Seller.Username</td>
                    <td>@product.Category.Name</td>

                    <td>
                        <span class="tag">
                            @(product.IsDeleted
                                ? "Deleted"
                                : product.ApprovalStatus)
                        </span>
                    </td>

                    <td>
                        @if (product.ApprovalStatus == "Rejected")
                        {
                            <span class="small">
                                @product.RejectionReason
                            </span>
                        }

                        else if (product.ApprovalStatus == "Pending"
                                 && !product.IsDeleted)
                        {
                            <div style="display:flex;flex-direction:column;gap:8px">

                                <form asp-controller="Admin"
                                      asp-action="ApproveProduct"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="productId"
                                           value="@product.ProductId" />

                                    <button class="btn btn-small"
                                            type="submit">
                                        Approve
                                    </button>
                                </form>

                                <form asp-controller="Admin"
                                      asp-action="RejectProduct"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="productId"
                                           value="@product.ProductId" />

                                    <textarea name="reason"
                                              class="field"
                                              maxlength="1000"
                                              rows="2"
                                              placeholder="Rejection reason"
                                              required></textarea>

                                    <button class="btn btn-small"
                                            type="submit">
                                        Reject
                                    </button>
                                </form>

                            </div>
                        }

                        {   
                            <span class="small">
                                Awaiting review
                            </span>
                        }
                        else
                        {
                            <span class="small">
                                @product.ApprovalStatus
                            </span>
                        }
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">
                        No products available.
                    </td>
                </tr>
            }

        </tbody>
    </table>

</div>


