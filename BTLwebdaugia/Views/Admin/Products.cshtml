
@{
    ViewData["Title"] = "Admin Products";
    Layout = "_AdminLayout";
}

<h1>Products management</h1>

<p class="muted">
    Administration wireframe preview.
    Only approved core workflows will be implemented in MVC.
</p>

<div class="table-shell">

    <div class="table-toolbar">

        <input class="field"
               placeholder="Search products" />

        <span>Filter by status ▾</span>

    </div>

    <table>
        <thead>
            <tr>
                <th>ITEM</th>
                <th>OWNER</th>
                <th>CATEGORY / VALUE</th>
                <th>STATUS</th>
                <th>ACTION</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td>Vintage camera</td>
                <td>Alex</td>
                <td>Collectibles</td>
                <td>Pending</td>
                <td>
                    <button class="btn btn-small"
                            data-demo-action="Approve">
                        Approve
                    </button>

                    <button class="btn btn-small"
                            data-demo-action="Reject with reason">
                        Reject
                    </button>
                </td>
            </tr>

            <tr>
                <td>Classic watch</td>
                <td>Morgan</td>
                <td>Fashion</td>
                <td>Rejected</td>
                <td>
                    <span class="small">
                        Reason required
                    </span>
                </td>
            </tr>
        </tbody>
    </table>

    <p id="action-feedback" class="notice"></p>

</div>

<div class="panel" style="margin-top:24px">

    <h3>Reject product — reason required</h3>

    <textarea class="field"
              rows="3"
              placeholder="Enter reason for rejection..."></textarea>

    <p class="notice">
        The actual approval/rejection action requires
        a secured Admin controller and validation.
    </p>

</div>
