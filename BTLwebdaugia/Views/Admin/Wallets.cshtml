
@model List<BTLwebdaugia.Models.Wallet>

@{
    ViewData["Title"] = "Admin Wallets";
    Layout = "_AdminLayout";
}

<h1>@Labels["Wallets management"]</h1>
<p class="muted">
    Virtual wallet balances from SQL Server
</p>

<div class="table-shell">
    <div class="table-toolbar">
        <h3>Wallets: @Model.Count</h3>
    </div>

    <table>
        <thead>
            <tr>
                <th>@Labels["WALLET ID"]</th>
                <th>@Labels["OWNER"]</th>
                <th>@Labels["BALANCE"]</th>
                <th>@Labels["CREATED"]</th>
                <th>@Labels["STATUS"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wallet in Model)
            {
                <tr>
                    <td>#@wallet.WalletId</td>
                    <td>@wallet.User.Username</td>
                    <td>$@wallet.Balance.ToString("N0")</td>
                    <td>
                        @wallet.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        UTC
                    </td>
                    <td>@Labels["Read only"]</td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">@Labels["No wallets found."]</td>
                </tr>
            }
        </tbody>
    </table>
</div>
