
@model List<BTLwebdaugia.Models.Wallet>

@{
    ViewData["Title"] = "Admin Wallets";
    Layout = "_AdminLayout";
}

<h1>Wallets management</h1>
<p class="muted">
    Virtual wallet balances from SQL Server
</p>

<div class="table-shell">
    <div class="table-toolbar">
        <h3>Wallets: @Model.Count</h3>
    </div>

    <table>
        <thead>
            <tr>
                <th>WALLET ID</th>
                <th>OWNER</th>
                <th>BALANCE</th>
                <th>CREATED</th>
                <th>STATUS</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wallet in Model)
            {
                <tr>
                    <td>#@wallet.WalletId</td>
                    <td>@wallet.User.Username</td>
                    <td>$@wallet.Balance.ToString("N0")</td>
                    <td>
                        @wallet.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        UTC
                    </td>
                    <td>Read only</td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">No wallets found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
