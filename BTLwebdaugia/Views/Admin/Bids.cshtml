
@model List<BTLwebdaugia.Models.Bid>

@{
    ViewData["Title"] = "Admin Bids";
    Layout = "_AdminLayout";
}

<h1>Bids management</h1>
<p class="muted">Accepted bidding history from SQL Server</p>

<div class="table-shell">
    <div class="table-toolbar">
        <h3>Displayed bids: @Model.Count</h3>
    </div>

    <table>
        <thead>
            <tr>
                <th>BID ID</th>
                <th>AUCTION / PRODUCT</th>
                <th>BIDDER</th>
                <th>AMOUNT</th>
                <th>PLACED AT</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bid in Model)
            {
                <tr>
                    <td>#@bid.BidId</td>
                    <td>
                        #@bid.AuctionId
                        @bid.AuctionNavigation.Product.Name
                    </td>
                    <td>@bid.Bidder.Username</td>
                    <td>$@bid.Amount.ToString("N0")</td>
                    <td>
                        @bid.PlacedAt.ToString("dd/MM/yyyy HH:mm:ss")
                        UTC
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">No bids found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
