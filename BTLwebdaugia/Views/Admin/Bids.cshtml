
@model List<BTLwebdaugia.Models.Bid>

@{
    ViewData["Title"] = Labels["Admin Bids"].Value;
    Layout = "_AdminLayout";
}

<h1>@Labels["Bids management"]</h1>
<partial name="_AdminListControls" />
<p class="muted">@Labels["Accepted bidding history from SQL Server"]</p>

<div class="table-shell">
    <div class="table-toolbar">
        <h3>Displayed bids: @Model.Count</h3>
    </div>

    <table>
        <thead>
            <tr>
                <th>@Labels["BID ID"]</th>
                <th>@Labels["AUCTION / PRODUCT"]</th>
                <th>@Labels["BIDDER"]</th>
                <th>@Labels["AMOUNT"]</th>
                <th>@Labels["PLACED AT"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bid in Model)
            {
                <tr>
                    <td>#@bid.BidId</td>
                    <td>
                        #@bid.AuctionId
                        @bid.AuctionNavigation.Product.Name
                    </td>
                    <td>@bid.Bidder.Username</td>
                    <td>$@bid.Amount.ToString("N0")</td>
                    <td>
                        @bid.PlacedAt.ToString("dd/MM/yyyy HH:mm:ss")
                        UTC
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5">@Labels["No bids found."]</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_AdminPager" />
