
@model BTLwebdaugia.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
}

<div class="container">
    <main class="container">

        <div class="crumb">
            Home / My account / My Profile
        </div>

        <div class="account">

            <aside class="sidebar">

                <div class="identity">
                    <div class="avatar">◯</div>

                    <strong>@Model.Username</strong>

                    <p class="muted small">
                        Member since
                        @Model.CreatedAt.ToString("MMMM yyyy")
                    </p>
                </div>

                <nav class="sidebar-nav">

                    <a class="active"
                       asp-controller="Account"
                       asp-action="Profile">
                        My Profile
                    </a>

                    <a asp-controller="Wallet"
                       asp-action="Index">
                        My Wallet
                    </a>

                    <a asp-controller="Selling"
                       asp-action="Index">
                        My Selling
                    </a>

                    <a asp-controller="Bidding"
                       asp-action="Index">
                        My Bidding
                    </a>

                    <a asp-controller="Orders"
                       asp-action="Index">
                        My Orders
                    </a>

                    <form asp-controller="Account"
                          asp-action="LogOut"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-small">
                            Log out
                        </button>
                    </form>

                </nav>

                <div class="panel help-box">
                    <strong>Need help?</strong>
                    <p class="small muted">
                        Contact our team for account support.
                    </p>
                </div>

            </aside>

            <section class="account-body">

                <div class="page-title">
                    <h1>My Profile</h1>

                    <p>
                        Manage your personal information.
                    </p>
                </div>

                @if (TempData["ProfileSuccess"] != null)
                {
                    <p class="notice">
                        @TempData["ProfileSuccess"]
                    </p>
                }

                <div class="panel">

                    <h3>Personal information</h3>

                    <div class="avatar">◯</div>

                    <p class="muted small">
                        Update your account details below.
                    </p>

                    <form asp-controller="Account"
                          asp-action="Profile"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger"></div>

                        <div class="form-row">

                            <div class="form-group">
                                <label asp-for="Username">
                                    Display name
                                </label>

                                <input asp-for="Username"
                                       class="field"
                                       maxlength="50"
                                       required />

                                <span asp-validation-for="Username"
                                      class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Email">
                                    Email address
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="field"
                                       maxlength="255"
                                       required />

                                <span asp-validation-for="Email"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <div class="form-group">
                            <label>Account created</label>

                            <input class="field"
                                   value="@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC"
                                   readonly />
                        </div>

                        <button class="btn btn-solid"
                                type="submit">
                            Save changes
                        </button>

                    </form>

                </div>

                <div class="panel" style="margin-top:24px">

                    <h3>Account &amp; security</h3>

                    <p class="muted">
                        Your password is securely stored
                        as a hash and is not displayed.
                    </p>

                    <p>
                        Account information is loaded
                        from SQL Server.
                    </p>

                </div>

            </section>

        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
