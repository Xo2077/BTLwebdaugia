
@model BTLwebdaugia.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";

    string? avatarPath = ViewBag.AvatarPath as string;
}

<div class="container">
    <main class="container">

        <div class="crumb">
            Home / My account / My Profile
        </div>

        <div class="account">

            <aside class="sidebar">

                <div class="identity">

                    @if (!string.IsNullOrWhiteSpace(avatarPath))
                    {
                        <img src="@avatarPath"
                             alt="Profile picture"
                             class="avatar"
                             style="width:72px;
                                    height:72px;
                                    border-radius:50%;
                                    object-fit:cover;" />
                    }
                    else
                    {
                        <div class="avatar">◯</div>
                    }

                    <strong>@Model.Username</strong>

                    <p class="muted small">
                        Member since
                        @Model.CreatedAt.ToString("MMMM yyyy")
                    </p>

                </div>

                <nav class="sidebar-nav">

                    <a class="active"
                       asp-controller="Account"
                       asp-action="Profile">
                        My Profile
                    </a>

                    <a asp-controller="Wallet"
                       asp-action="Index">
                        My Wallet
                    </a>

                    <a asp-controller="Selling"
                       asp-action="Index">
                        My Selling
                    </a>

                    <a asp-controller="Bidding"
                       asp-action="Index">
                        My Bidding
                    </a>

                    <a asp-controller="Orders"
                       asp-action="Index">
                        My Orders
                    </a>

                    <form asp-controller="Account"
                          asp-action="LogOut"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-small">
                            Log out
                        </button>

                    </form>

                </nav>

                <div class="panel help-box">
                    <strong>Need help?</strong>

                    <p class="small muted">
                        Contact our team for account support.
                    </p>
                </div>

            </aside>

            <section class="account-body">

                <div class="page-title">
                    <h1>My Profile</h1>

                    <p>
                        Manage your personal information
                        and profile picture.
                    </p>
                </div>

                @if (TempData["ProfileSuccess"] != null)
                {
                    <p class="notice" role="status">
                        @TempData["ProfileSuccess"]
                    </p>
                }

                @if (TempData["AvatarError"] != null)
                {
                    <p class="text-danger" role="alert">
                        @TempData["AvatarError"]
                    </p>
                }

                <div class="panel">

                    <h3>Profile picture</h3>

                    @if (!string.IsNullOrWhiteSpace(avatarPath))
                    {
                        <img src="@avatarPath"
                             alt="Current profile picture"
                             class="avatar"
                             style="width:96px;
                                    height:96px;
                                    border-radius:50%;
                                    object-fit:cover;" />
                    }
                    else
                    {
                        <div class="avatar">◯</div>
                    }

                    <form asp-controller="Account"
                          asp-action="UploadAvatar"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label for="avatar">
                                Choose profile picture
                            </label>

                            <input id="avatar"
                                   name="avatar"
                                   type="file"
                                   accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                                   class="field"
                                   required />
                        </div>

                        <p class="muted small">
                            JPG or PNG. Maximum file size 2 MB.
                        </p>

                        <button type="submit"
                                class="btn btn-solid">
                            Upload picture
                        </button>

                    </form>

                </div>

                <div class="panel" style="margin-top:24px">

                    <h3>Personal information</h3>

                    <form asp-controller="Account"
                          asp-action="Profile"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger"></div>

                        <div class="form-row">

                            <div class="form-group">

                                <label asp-for="Username">
                                    Display name
                                </label>

                                <input asp-for="Username"
                                       class="field"
                                       maxlength="50"
                                       required />

                                <span asp-validation-for="Username"
                                      class="text-danger"></span>

                            </div>

                            <div class="form-group">

                                <label asp-for="Email">
                                    Email address
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="field"
                                       maxlength="255"
                                       required />

                                <span asp-validation-for="Email"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="form-group">

                            <label>Account created</label>

                            <input class="field"
                                   value="@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC"
                                   readonly />

                        </div>

                        <button class="btn btn-solid"
                                type="submit">
                            Save changes
                        </button>

                    </form>

                </div>

                <div class="panel" style="margin-top:24px">

                    <h3>Account &amp; security</h3>

                    <p class="muted">
                        Your password is securely stored
                        as a hash and is not displayed.
                    </p>

                </div>

            </section>

        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
