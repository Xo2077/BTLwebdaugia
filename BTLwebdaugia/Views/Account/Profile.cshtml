
@model BTLwebdaugia.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = Labels["My Profile"].Value;
    Layout = "_Layout";

}

<div class="container">
    <main class="container">

        <div class="crumb">
            Home / My account / My Profile
        </div>

        <div class="account" data-account-page="profile">

            @await Html.PartialAsync("_AccountSidebar")

            <div id="account-content">
                @await Html.PartialAsync("_ProfileContent", Model)
            </div>

        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
