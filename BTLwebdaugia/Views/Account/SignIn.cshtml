@model BTLwebdaugia.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container">
    <section class="auth-shell panel">
        <h1>Sign In</h1>

        <form asp-controller="Account" asp-action="SignIn" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div asp-validation-summary="ModelOnly" class="notice text-danger"></div>

            <div class="form-group">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email" class="field"
                       type="email" placeholder="Enter your email address"
                       autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" class="field"
                       type="password" placeholder="Enter your password"
                       autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <label>
                    <input asp-for="RememberMe" type="checkbox" />
                    Remember me
                </label>
                <a href="#">Forgot password?</a>
            </div>

            <button class="btn btn-solid btn-wide"
                    type="submit" style="margin-top:22px">
                Sign In
            </button>
        </form>

        <p>
            Don't have an account?
            <a asp-controller="Account" asp-action="SignUp">
                <strong>Sign Up</strong>
            </a>
        </p>
    </section>
</div>
