
@{
    ViewData["Title"] = Labels["Log out"].Value;
    Layout = "_Layout";
}

<div class="container">

    <main class="container">
        <div class="crumb">Home / My account / Log out</div>
        <div class="account">
            <aside class="sidebar">
                <div class="identity">
                    <div class="avatar">◯</div><strong>@Labels["User Name"]</strong>
                    <p class="muted small">Member since October 2026</p>
                </div>
                <nav class="sidebar-nav">
                    <a asp-controller="Account"
                       asp-action="Profile">@Labels["My Profile"]</a>
                    
                    <a asp-controller="Wallet"
                       asp-action="Index">@Labels["My Wallet"]</a>     
                        
                    <a asp-controller="Selling"
                       asp-action="Index">@Labels["My Selling"]</a>
                    
                    <a asp-controller="Bidding"
                       asp-action="Index">@Labels["My Bidding"]</a>    
                        
                    <a asp-controller="Orders"
                       asp-action="Index">@Labels["My Orders"]</a>

                    <a class="active"
                       asp-controller="Account"
                       asp-action="LogOut">
                       @Labels["Log out"]
                    </a>
                </nav>
                <div class="panel help-box"><strong>@Labels["Need help?"]</strong>
                    <p class="small muted">Contact our team for account or auction support.</p><a href="#">Contact
                        us</a>
                </div>
            </aside>
            <section class="account-body">
                <div class="page-title">
                    <h1>@Labels["Log out"]</h1>
                    <p>Review your account before signing out of BidHub.</p>
                </div>
                <div class="panel">
                    <h3>@Labels["Log out of your account?"]</h3>
                    <p>Logging out does not cancel your bids or orders.</p>

                    <a class="btn btn-solid"
                       asp-controller="Account"
                       asp-action="SignIn">
                        Back to Sign in
                    </a>

                </div>
            </section>
        </div>
    </main>

</div>
