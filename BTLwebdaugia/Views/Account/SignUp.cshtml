@model BTLwebdaugia.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Sign Up";
    Layout = "_Layout";
}

<div class="container">

    <section class="auth-shell panel">

        <h1>Sign Up</h1>

        <form asp-controller="Account" asp-action="SignUp" method="post">
            @Html.AntiForgeryToken()

            <div class="form-row">

                <div class="form-group">
                    <label asp-for="FirstName">First name</label>
                    <input asp-for="FirstName" class="field"
                           placeholder="First name"
                           autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName">Last name</label>
                    <input asp-for="LastName" class="field"
                           placeholder="Last name"
                           autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

            </div>

            <div class="form-group">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email" class="field"
                       type="email"
                       placeholder="Enter your email address"
                       autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" class="field"
                       type="password"
                       placeholder="Create a password"
                       autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm password</label>
                <input asp-for="ConfirmPassword" class="field"
                       type="password"
                       placeholder="Re-enter your password"
                       autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <label>
                <input asp-for="AgreeToTerms" type="checkbox" />
                I am 18 or older and agree to the Terms of Service.
            </label>
            <span asp-validation-for="AgreeToTerms" class="text-danger"></span>

            <button class="btn btn-solid btn-wide"
                    type="submit"
                    style="margin-top:20px">
                Sign Up
            </button>

            <div asp-validation-summary="ModelOnly" class="notice"></div>
        </form>

        <p>
            Already have an account?

            <a asp-controller="Account"
               asp-action="SignIn">
                Sign In
            </a>
        </p>

    </section>

</div>
