@model BTLwebdaugia.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = Labels["Sign Up"].Value;
    Layout = "_Layout";
}

<div class="container">

    <section class="auth-shell panel">

        <h1>@Labels["Sign Up"]</h1>

        <form asp-controller="Account" asp-action="SignUp" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Username">@Labels["Registration username"]</label>
                <input asp-for="Username" class="field"
                       placeholder="@Labels["Enter a username"]"
                       autocomplete="username" minlength="3" maxlength="50"
                       aria-describedby="username-help" />
                <small id="username-help">@Labels["Use 3–50 characters: letters, numbers, dots, underscores or hyphens."]</small>
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">@Labels["Email address"]</label>
                <input asp-for="Email" class="field"
                       type="email"
                       placeholder="@Labels["Enter your email address"]"
                       autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">@Labels["Password"]</label>
                <input asp-for="Password" class="field"
                       type="password"
                       placeholder="@Labels["Create a password"]"
                       autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">@Labels["Confirm password"]</label>
                <input asp-for="ConfirmPassword" class="field"
                       type="password"
                       placeholder="@Labels["Re-enter your password"]"
                       autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <label>
                <input asp-for="AgreeToTerms" type="checkbox" />
                @Labels["I am 18 or older and agree to the Terms of Service."]
            </label>
            <span asp-validation-for="AgreeToTerms" class="text-danger"></span>

            <button class="btn btn-solid btn-wide"
                    type="submit"
                    style="margin-top:20px">
                @Labels["Sign Up"]
            </button>

            <div asp-validation-summary="ModelOnly" class="notice"></div>
        </form>

        <p>
            @Labels["Already have an account?"]

            <a asp-controller="Account"
               asp-action="SignIn">
                @Labels["Sign in"]
            </a>
        </p>

    </section>

</div>
