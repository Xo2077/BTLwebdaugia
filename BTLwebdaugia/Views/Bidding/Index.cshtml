@model List<BTLwebdaugia.ViewModels.MyBiddingItemViewModel>

@{
    ViewData["Title"] = "My Bidding";
    Layout = "_Layout";

    int activeCount = Model.Count(x =>
        x.Status == "Leading" ||
        x.Status == "Outbid");

    int leadingCount = Model.Count(x =>
        x.Status == "Leading");

    int outbidCount = Model.Count(x =>
        x.Status == "Outbid");

    int wonCount = Model.Count(x =>
        x.Status == "Won");
}

<div class="container">

    <div class="crumb">
        Home / My account / My Bidding
    </div>

    <div class="account">

        <aside class="sidebar">

            <div class="identity">
                <div class="avatar">◯</div>

                <strong>
                    @User.Identity?.Name
                </strong>
            </div>

            <nav class="sidebar-nav">

                <a asp-controller="Account"
                   asp-action="Profile">
                    My Profile
                </a>

                <a asp-controller="Wallet"
                   asp-action="Index">
                    My Wallet
                </a>

                <a asp-controller="Selling"
                   asp-action="Index">
                    My Selling
                </a>

                <a class="active"
                   asp-controller="Bidding"
                   asp-action="Index">
                    My Bidding
                </a>

                <a asp-controller="Orders"
                   asp-action="Index">
                    My Orders
                </a>

                <form asp-controller="Account"
                      asp-action="LogOut"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-small">
                        Log out
                    </button>

                </form>

            </nav>

        </aside>

        <section class="account-body">

            <div class="page-title">
                <h1>My Bidding</h1>

                <p>
                    Your auction activity from SQL Server.
                </p>
            </div>

            <div class="metrics">

                <div class="metric">
                    <div class="muted small">
                        Active auctions
                    </div>
                    <strong>@activeCount</strong>
                </div>

                <div class="metric">
                    <div class="muted small">
                        Currently leading
                    </div>
                    <strong>@leadingCount</strong>
                </div>

                <div class="metric">
                    <div class="muted small">
                        Outbid
                    </div>
                    <strong>@outbidCount</strong>
                </div>

                <div class="metric">
                    <div class="muted small">
                        Auctions won
                    </div>
                    <strong>@wonCount</strong>
                </div>

            </div>

            <div class="table-shell">

                <h3>Your auctions</h3>

                <table>
                    <thead>
                        <tr>
                            <th>AUCTION / PRODUCT</th>
                            <th>CURRENT BID</th>
                            <th>YOUR HIGHEST BID</th>
                            <th>END TIME</th>
                            <th>STATUS</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6">
                                    You have not placed any bids yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        #@item.AuctionId

                                        <strong>
                                            @item.ProductName
                                        </strong>
                                    </td>

                                    <td>
                                        $@item.CurrentHighestBid.ToString("N0")
                                    </td>

                                    <td>
                                        $@item.MyHighestBid.ToString("N0")
                                    </td>

                                    <td>
                                        @item.CurrentEndAt.ToString("dd/MM/yyyy HH:mm")
                                        UTC
                                    </td>

                                    <td>
                                        <span class="tag">
                                            @item.Status
                                        </span>
                                    </td>

                                    <td>
                                        <a asp-controller="Auction"
                                           asp-action="Details"
                                           asp-route-id="@item.AuctionId">
                                            View auction
                                        </a>
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>
                </table>

            </div>

        </section>

    </div>

</div>
