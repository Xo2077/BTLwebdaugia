@model List<BTLwebdaugia.ViewModels.MyBiddingItemViewModel>

@{
    ViewData["Title"] = Labels["My Bidding"].Value;
    Layout = "_Layout";


}

<div class="container">

    <div class="crumb">
        Home / My account / My Bidding
    </div>

    <div class="account" data-account-page="bidding">

        @await Html.PartialAsync("_AccountSidebar")

        <div id="account-content">
            @await Html.PartialAsync("_BiddingContent", Model)
        </div>

    </div>

</div>
