@model List<BTLwebdaugia.ViewModels.ProductListItemViewModel>
@using BTLwebdaugia.ViewModels

@{
    ViewData["Title"] = "Homepage";
    Layout = "_Layout";

    var categories =
        ViewBag.Categories as List<CategoryViewModel>
        ?? new List<CategoryViewModel>();
}


<main>
    <div class="container">

        <div class="hero">
            <div>
                <h1>
                    @Labels["Discover unique items and win your next auction"]
                </h1>

                <p class="muted">
                    @Labels["Explore BidHub auctions and find products from independent sellers."]
                </p>

                <a class="btn btn-solid"
                   asp-controller="Home"
                   asp-action="Category">
                    @Labels["Explore Auctions"]
                </a>
            </div>

            <div class="image-box"
                 role="img"
                 aria-label="BidHub hero illustration">
            </div>
        </div>

        <div class="logos">
            @for (int i = 0; i < 5; i++)
            {
                <div class="image-box logo-placeholder"></div>
            }
        </div>

        <section class="section">
            <h2>@Labels["Category"]</h2>


            <div class="category-grid">

                <a class="category-button selected"
                   asp-controller="Home"
                   asp-action="Index"
                   data-category-id="">
                    All categories
                </a>

                @if (!categories.Any())
                {
                    <p class="muted">
                        No categories available.
                    </p>
                }
                else
                {
                    @foreach (var category in categories)
                    {
                        <a class="category-button"
                           asp-controller="Home"
                           asp-action="Category"
                           asp-route-CategoryId="@category.CategoryId"
                           data-category-id="@category.CategoryId">
                            @category.Name
                        </a>
                    }
                }

            </div>
        </section>


        <div id="auction-ajax-status"
             role="status"
             aria-live="polite">
        </div>

        <div id="auction-results">
            @await Html.PartialAsync("AuctionSections", Model)
        </div>

    </div>
</main>

                           

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"
            asp-append-version="true"></script>

    <script>
        $(function () {

            const ajaxUrl = '@Url.Action("FilterAuctions", "Home")';

            let currentRequest = null;

            $(".category-grid").on(
                "click",
                ".category-button",
                function (event) {

                    event.preventDefault();

                    const clickedButton = $(this);

                    const categoryId =
                        clickedButton.attr("data-category-id");

                    // 1. Bôi đen ngay danh mục được chọn.
                    $(".category-grid .category-button")
                        .removeClass("selected")
                        .removeAttr("aria-current");

                    clickedButton
                        .addClass("selected")
                        .attr("aria-current", "true");

                    // 2. Hủy request cũ khi chọn nhanh.
                    if (currentRequest) {
                        currentRequest.abort();
                    }

                    // 3. Thông báo trạng thái tải.
                    $("#auction-ajax-status")
                        .text("Loading auctions...");

                    // 4. Lấy dữ liệu mới từ server.
                    const request = $.ajax({
                        url: ajaxUrl,
                        type: "GET",
                        data: {
                            categoryId: categoryId
                        },
                        dataType: "html",
                        cache: false
                    });

                    currentRequest = request;

                    request.done(function (response) {

                        // Chỉ cập nhật kết quả request mới nhất.
                        if (currentRequest !== request) {
                            return;
                        }

                        // HTML vẫn được cập nhật khi không có card.
                        $("#auction-results").html(response);

                        $("#auction-ajax-status").text("");
                    });

                    request.fail(function (xhr, status) {

                        if (
                            status === "abort" ||
                            currentRequest !== request
                        ) {
                            return;
                        }

                        $("#auction-ajax-status").text(
                            "Failed to load auctions. Please try again."
                        );
                    });

                    request.always(function () {

                        if (currentRequest === request) {
                            currentRequest = null;
                        }
                    });

                }
            );

        });
    </script>
}
