
@using BTLwebdaugia.ViewModels

@{
    ViewData["Title"] = "Homepage";
    Layout = "_Layout";

    var categories =
        ViewBag.Categories as List<CategoryViewModel>
        ?? new List<CategoryViewModel>();

    var live =
        ViewBag.LiveAuctions as List<ProductListItemViewModel>
        ?? new List<ProductListItemViewModel>();

    var upcoming =
        ViewBag.UpcomingAuctions as List<ProductListItemViewModel>
        ?? new List<ProductListItemViewModel>();

    var ended =
        ViewBag.EndedAuctions as List<ProductListItemViewModel>
        ?? new List<ProductListItemViewModel>();

    var groups = new[]
    {
        new {
            Title = "Live Auction",
            Status = "Live",
            Css = "live",
            Items = live
        },
        new {
            Title = "Upcoming Auction",
            Status = "Upcoming",
            Css = "upcoming",
            Items = upcoming
        },
        new {
            Title = "End Auction",
            Status = "Ended",
            Css = "ended",
            Items = ended
        }
    };
}

<main>
    <div class="container">

        <div class="hero">
            <div>
                <h1>
                    Discover unique items and win
                    your next auction
                </h1>

                <p class="muted">
                    Explore BidHub auctions and find
                    products from independent sellers.
                </p>

                <a class="btn btn-solid"
                   asp-controller="Home"
                   asp-action="Category">
                    Explore Auctions
                </a>
            </div>

            <div class="image-box"
                 role="img"
                 aria-label="BidHub hero illustration">
                HERO IMAGE PLACEHOLDER
            </div>
        </div>

        <div class="logos">
            @for (int i = 0; i < 5; i++)
            {
                <div class="image-box logo-placeholder"
                     role="img"
                     aria-label="Partner illustration">
                    PARTNER LOGO
                </div>
            }
        </div>

        <section class="section">
            <h2>Category</h2>

            <div class="category-grid">

                @if (!categories.Any())
                {
                    <p class="muted">
                        No categories available.
                    </p>
                }
                else
                {
                    @foreach (var category in categories)
                    {
                        <a class="category-button"
                           asp-controller="Home"
                           asp-action="Category"
                           asp-route-CategoryId="@category.CategoryId">
                            @category.Name
                        </a>
                    }
                }

            </div>
        </section>

        @foreach (var group in groups)
        {
            <section class="auction-section"
                     data-auction-section="@group.Css">

                <div class="section-heading">
                    <h2>@group.Title</h2>
                </div>

                <div class="auction-list @(group.Css == "upcoming" ? "upcoming-list" : "")">

                    @if (!group.Items.Any())
                    {
                        <div class="empty-message">
                            No @group.Status.ToLowerInvariant()
                            auctions available.
                        </div>
                    }
                    else
                    {

                        @foreach (var product in group.Items)
                        {
                            <article class="product-card @(group.Css == "upcoming" ? "product-horizontal" : "")">

                                <div class="image-box product-image-frame">

                                    @if (!string.IsNullOrWhiteSpace(product.ImagePath))
                                    {
                                        <img src="@product.ImagePath"
                                             alt="@product.Name"
                                             loading="lazy"
                                             class="product-image"
                                             style="display:block;
                                        width:100%;
                                        height:100%;
                                        max-width:100%;
                                        max-height:100%;
                                        object-fit:contain;
                                        object-position:center;" />
                                    }
                                    else
                                    {
                                        <span class="muted small">
                                            No product image
                                        </span>
                                    }

                                </div>

                                <div>
                                    <span class="tag">
                                        @product.AuctionStatus
                                    </span>

                                    <h3>@product.Name</h3>

                                    <p class="muted">
                                        @product.CategoryName
                                    </p>

                                    <p class="muted">
                                        @(group.Status == "Upcoming"
                                            ? "Starting price"
                                            : "Current / highest bid")
                                    </p>

                                    <p class="bid-price">
                                        $@product.CurrentPrice.ToString("N0")
                                    </p>

                                    <p class="small">
                                        Ends:
                                        @product.CurrentEndAt.ToString("dd/MM/yyyy HH:mm")
                                        UTC
                                    </p>

                                    <div class="card-bottom">
                                        <a class="btn btn-small"
                                           asp-controller="Auction"
                                           asp-action="Details"
                                           asp-route-id="@product.AuctionId">
                                            @(group.Status == "Live"
                                                ? "Bid now"
                                                : "View product")
                                        </a>
                                    </div>
                                </div>

                            </article>
                        }

                    }

                </div>

                <div class="section-footer">
                    <a class="btn"
                       asp-controller="Home"
                       asp-action="Category"
                       asp-route-Status="@group.Status">
                        View All
                    </a>
                </div>

            </section>
        }

    </div>
</main>
