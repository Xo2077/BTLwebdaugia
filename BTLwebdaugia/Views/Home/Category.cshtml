
@model BTLwebdaugia.ViewModels.ProductListViewModel

@{
    ViewData["Title"] = "Category & Search";
    Layout = "_Layout";
    var now = DateTime.UtcNow;
}

<main class="container">

    <div class="crumb">Home / Category</div>

    <div class="page-title">
        <h1>Explore auctions</h1>
        <p>
            Discover live listings and browse by category.
        </p>
    </div>

    <div class="filter-layout">

        <aside class="panel filters">

            <h3>Filters</h3>

            <form asp-controller="Home"
                  asp-action="Category"
                  method="get">

                <div class="form-group">
                    <label for="SearchTerm">
                        Search product
                    </label>

                    <input class="field"
                           type="search"
                           id="SearchTerm"
                           name="SearchTerm"
                           value="@Model.Filter.SearchTerm"
                           placeholder="Search auctions..." />
                </div>

                <div class="form-group">
                    <label for="CategoryId">
                        Categories
                    </label>

                    <select class="field"
                            id="CategoryId"
                            name="CategoryId">

                        <option value="">
                            All categories
                        </option>

                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryId"
                                    selected="@(Model.Filter.CategoryId == category.CategoryId)">
                                @category.Name
                            </option>
                        }

                    </select>
                </div>

                <div class="form-group">
                    <label for="Status">
                        Auction status
                    </label>

                    <select class="field"
                            id="Status"
                            name="Status">

                        @foreach (string status in new[]
                            { "All", "Live", "Upcoming", "Ended" })
                        {
                            <option value="@status"
                                    selected="@(Model.Filter.Status == status)">
                                @status
                            </option>
                        }

                    </select>
                </div>

                <div class="form-group">
                    <label for="SortBy">
                        Sort by
                    </label>

                    <select class="field"
                            name="SortBy"
                            id="SortBy">

                        <option value="EndingSoon"
                                selected="@(Model.Filter.SortBy == "EndingSoon")">
                            Ending soonest
                        </option>

                        <option value="Newest"
                                selected="@(Model.Filter.SortBy == "Newest")">
                            Newest
                        </option>

                        <option value="PriceLow"
                                selected="@(Model.Filter.SortBy == "PriceLow")">
                            Price: Low to High
                        </option>

                        <option value="PriceHigh"
                                selected="@(Model.Filter.SortBy == "PriceHigh")">
                            Price: High to Low
                        </option>

                    </select>
                </div>

                <button type="submit"
                        class="btn btn-solid btn-wide">
                    Apply filters
                </button>

            </form>

        </aside>

        <section>

            <div class="table-toolbar">
                <h2>Live & upcoming listings</h2>

                <span class="muted">
                    @Model.TotalItems results
                </span>
            </div>

            <div class="grid grid-3">

                @if (!Model.Products.Any())
                {
                    <div class="panel">
                        <p>
                            No auctions matched your filters.
                        </p>
                    </div>
                }

                @foreach (var product in Model.Products)
                {
                    <article class="product-card"
                             data-category="@product.CategoryName">

                        @if (!string.IsNullOrWhiteSpace(product.ImagePath))
                        {
                            <div class="image-box">
                                <img src="@product.ImagePath"
                                     alt="@product.Name"
                                     loading="lazy"
                                     style="width:100%;height:100%;object-fit:cover;" />
                            </div>
                        }
                        else
                        {
                            <div class="image-box"
                                 role="img"
                                 aria-label="PRODUCT IMAGE">
                                PRODUCT IMAGE
                            </div>
                        }

                        <h3>@product.Name</h3>

                        <p>
                            <span class="tag">
                                @product.AuctionStatus
                            </span>
                        </p>

                        <p class="muted">
                            @(product.AuctionStatus == "Upcoming"
                                ? "Starting price"
                                : product.AuctionStatus == "Ended"
                                    ? "Final / highest bid"
                                    : "Current bid")
                        </p>

                        <p class="bid-price">
                            $@product.CurrentPrice.ToString("N0")
                        </p>

                        <p class="small">
                            @if (product.AuctionStatus == "Ended")
                            {
                                <span>
                                    Ended:
                                    @product.CurrentEndAt.ToString("dd/MM/yyyy HH:mm")
                                    UTC
                                </span>
                            }
                            else
                            {
                                <span>
                                    Ends:
                                    @product.CurrentEndAt.ToString("dd/MM/yyyy HH:mm")
                                    UTC
                                </span>
                            }
                        </p>

                        <div class="card-bottom">

                            <span class="muted small">
                                BidHub auction
                            </span>

                            <a class="btn btn-small"
                               asp-controller="Auction"
                               asp-action="Details"
                               asp-route-id="@product.AuctionId">
                                @(product.AuctionStatus == "Live"
                                    ? "Bid now"
                                    : "View product")
                            </a>

                        </div>

                    </article>
                }

            </div>


                @if (Model.TotalPages > 1)
                {
                    <div class="pager">

                        @for (int pageNumber = 1;
                              pageNumber <= Model.TotalPages;
                              pageNumber++)
                        {
                            <a class="btn @(pageNumber == Model.Filter.Page ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Category"
                               asp-route-SearchTerm="@Model.Filter.SearchTerm"
                               asp-route-CategoryId="@Model.Filter.CategoryId"
                               asp-route-Status="@Model.Filter.Status"
                               asp-route-SortBy="@Model.Filter.SortBy"
                               asp-route-Page="@(pageNumber)">
                                @(pageNumber)
                            </a>
                        }

                    </div>
                }


        </section>

    </div>

</main>
