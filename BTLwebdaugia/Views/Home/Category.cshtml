                        <p class="small">Ends in: <strong class="countdown" data-seconds="420000"></strong></p>
                        <div class="card-bottom"><span class="muted small">BidHub auction</span>
                            <a class="btn btn-small"
                               asp-controller="Auction"
                               asp-action="Details">
                                Bid now
                            </a>
                        </div>
                    </article>
                </div>
                <div class="pager"><button class="active">1</button><button>2</button><button>3</button></div>
            </section>
        </div>
    </main>