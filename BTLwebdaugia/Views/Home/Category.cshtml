                               asp-action="Details">
                                Bid now
                            </a>
                        </div>
                    </article>
                    <article class="product-card" data-category="Fine Art">
                        <div aria-label="PRODUCT IMAGE" class="image-box" role="img">PRODUCT IMAGE</div>
                        <h3>Walnut turntable</h3>
