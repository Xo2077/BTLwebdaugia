                               asp-action="Details">
                                Bid now
                            </a>
                        </div>
                    </article>
                    <article class="product-card" data-category="Designer Fashion">
                        <div aria-label="PRODUCT IMAGE" class="image-box" role="img">PRODUCT IMAGE</div>
                        <h3>Leather handbag</h3>
