
@model List<BTLwebdaugia.Models.Product>

@using System.Linq
@using BTLwebdaugia.Models

@{
    ViewData["Title"] = "My Selling";
    Layout = "_Layout";

    var now = DateTime.UtcNow;

    var totalListings = Model.Count;

    var pendingCount = Model.Count(p =>
        p.ApprovalStatus == "Pending");

    var rejectedCount = Model.Count(p =>
        p.ApprovalStatus == "Rejected");

    var liveCount = Model.Count(p =>
        p.ApprovalStatus == "Approved" &&
        p.Auctions.Any(a =>
            a.ApprovalStatus == "Approved" &&
            a.StartAt <= now &&
            a.CurrentEndAt > now));

    var totalBids = Model.Sum(p =>
        p.Auctions.Sum(a => a.Bids.Count));
}

<div class="container">
    <main class="container">

        <div class="crumb">
            Home / My account / My Selling
        </div>

        <div class="account">

            <aside class="sidebar">

                <div class="identity">
                    <div class="avatar">◯</div>

                    <strong>
                        @User.Identity?.Name
                    </strong>

                    <p class="muted small">
                        BidHub member
                    </p>
                </div>

                <nav class="sidebar-nav">

                    <a asp-controller="Account"
                       asp-action="Profile">
                        My Profile
                    </a>

                    <a asp-controller="Wallet"
                       asp-action="Index">
                        My Wallet
                    </a>

                    <a class="active"
                       asp-controller="Selling"
                       asp-action="Index">
                        My Selling
                    </a>

                    <a asp-controller="Bidding"
                       asp-action="Index">
                        My Bidding
                    </a>

                    <a asp-controller="Orders"
                       asp-action="Index">
                        My Orders
                    </a>

                    <form asp-controller="Account"
                          asp-action="LogOut"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn">
                            Log out
                        </button>
                    </form>

                </nav>

                <div class="panel help-box">
                    <strong>Need help?</strong>
                    <p class="small muted">
                        Contact our team for account
                        or auction support.
                    </p>
                    <a href="#">Contact us</a>
                </div>

            </aside>

            <section class="account-body">

                <div class="page-title">
                    <h1>My Selling</h1>
                    <p>
                        Manage your listings and keep
                        every auction on track.
                    </p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="callout">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <div class="metrics">

                    <div class="metric">
                        <div class="muted small">
                            Live auctions
                        </div>
                        <strong>@liveCount</strong>
                        <small>Currently active</small>
                    </div>

                    <div class="metric">
                        <div class="muted small">
                            Total bids
                        </div>
                        <strong>@totalBids</strong>
                        <small>Across your listings</small>
                    </div>

                    <div class="metric">
                        <div class="muted small">
                            Total listings
                        </div>
                        <strong>@totalListings</strong>
                        <small>Non-deleted products</small>
                    </div>

                    <div class="metric">
                        <div class="muted small">
                            Pending review
                        </div>
                        <strong>@pendingCount</strong>
                        <small>
                            @rejectedCount rejected listings
                        </small>
                    </div>

                </div>

                <div class="table-shell">

                    <div class="table-toolbar">

                        <h3>Your listings</h3>

                        <a class="btn"
                           asp-controller="Product"
                           asp-action="Create">
                            Create listing
                        </a>

                    </div>

                    <div class="tabs">
                        <span class="active">All listings</span>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th>ITEM</th>
                                <th>PRICE / BID</th>
                                <th>BIDS</th>
                                <th>TIME</th>
                                <th>STATUS</th>
                                <th>ACTION</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6">
                                        You have not created
                                        any listings yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var product in Model)
                                {
                                    var auction = product.Auctions
                                        .OrderByDescending(a => a.AuctionId)
                                        .FirstOrDefault();

                                    var bidCount = auction?.Bids.Count ?? 0;

                                    string status = product.ApprovalStatus;

                                    if (product.ApprovalStatus == "Approved"
                                        && auction != null)
                                    {
                                        if (auction.ApprovalStatus != "Approved")
                                        {
                                            status = auction.ApprovalStatus;
                                        }
                                        else if (auction.StartAt > now)
                                        {
                                            status = "Upcoming";
                                        }
                                        else if (auction.CurrentEndAt > now)
                                        {
                                            status = "Live";
                                        }
                                        else
                                        {
                                            status = auction.Result ?? "Ended";
                                        }
                                    }

                                    <tr>
                                        <td>
                                            @product.Name
                                        </td>

                                        <td>
                                            @if (auction != null)
                                            {
                                                <span>
                                                    $@auction.StartingPrice.ToString("N0")
                                                </span>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>

                                        <td>@bidCount</td>

                                        <td>
                                            @if (auction != null)
                                            {
                                                @auction.CurrentEndAt.ToString("dd/MM/yyyy HH:mm")
                                                <small>UTC</small>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>

                                        <td>
                                            <span class="tag">
                                                @status
                                            </span>
                                        </td>

                                        <td>
                                            @if (auction != null)
                                            {
                                                <a asp-controller="Auction"
                                                   asp-action="Details"
                                                   asp-route-id="@auction.AuctionId">
                                                    View auction
                                                </a>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>

                </div>

                <div class="callout">
                    After approval, a seller cannot edit
                    or delete the approved product.
                    Rejected listings can be corrected
                    and resubmitted when that functionality
                    is implemented.
                </div>

            </section>

        </div>

    </main>
</div>
