
@model List<BTLwebdaugia.Models.Product>

@using System.Linq
@using BTLwebdaugia.Models

@{
    ViewData["Title"] = Labels["My Selling"].Value;
    Layout = "_Layout";

}

<div class="container">
    <main class="container">

        @await Html.PartialAsync("_AccountBreadcrumb", "My Selling")

        <div class="account" data-account-page="selling">

            @await Component.InvokeAsync("AccountSidebar")

            <div id="account-content">
                @await Html.PartialAsync("_SellingContent", Model)
            </div>

        </div>

    </main>
</div>
