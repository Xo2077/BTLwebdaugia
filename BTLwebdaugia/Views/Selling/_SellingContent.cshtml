@model List<BTLwebdaugia.Models.Product>

@{
    var now = DateTime.UtcNow;

    var totalListings = Model.Count;

    var pendingCount = Model.Count(p =>
        p.ApprovalStatus == "Pending");

    var rejectedCount = Model.Count(p =>
        p.ApprovalStatus == "Rejected");

    var liveCount = Model.Count(p =>
        p.ApprovalStatus == "Approved" &&
        p.Auctions.Any(a =>
            a.ApprovalStatus == "Approved" &&
            a.StartAt <= now &&
            a.CurrentEndAt > now));

    var totalBids = Model.Sum(p =>
        p.Auctions.Sum(a => a.Bids.Count));
}

            <section class="account-body">

                <div class="page-title">
                    <h1>@Labels["My Selling"]</h1>
                    <p>
                        Manage your listings and keep
                        every auction on track.
                    </p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="callout">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <div class="metrics">

                    <div class="metric">
                        <div class="muted small">
                            @Labels["Live auctions"]
                        </div>
                        <strong>@liveCount</strong>
                        <small>Currently active</small>
                    </div>

                    <div class="metric">
                        <div class="muted small">
                            Total bids
                        </div>
                        <strong>@totalBids</strong>
                        <small>@Labels["Across your listings"]</small>
                    </div>

                    <div class="metric">
                        <div class="muted small">
                            Total listings
                        </div>
                        <strong>@totalListings</strong>
                        <small>Non-deleted products</small>
                    </div>

                    <div class="metric">
                        <div class="muted small">
                            Pending review
                        </div>
                        <strong>@pendingCount</strong>
                        <small>
                            @rejectedCount rejected listings
                        </small>
                    </div>

                </div>

                <div class="table-shell">

                    <div class="table-toolbar">

                        <h3>@Labels["Your listings"]</h3>

                        <a class="btn"
                           asp-controller="Product"
                           asp-action="Create">
                            Create listing
                        </a>

                    </div>

                    <div class="tabs">
                        <span class="active">@Labels["All listings"]</span>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th>@Labels["ITEM"]</th>
                                <th>PRICE / BID</th>
                                <th>@Labels["BIDS"]</th>
                                <th>@Labels["TIME"]</th>
                                <th>@Labels["STATUS"]</th>
                                <th>@Labels["ACTION"]</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6">
                                        You have not created
                                        any listings yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var product in Model)
                                {
                                    var auction = product.Auctions
                                        .OrderByDescending(a => a.AuctionId)
                                        .FirstOrDefault();

                                    var bidCount = auction?.Bids.Count ?? 0;

                                    string status = product.ApprovalStatus;

                                    if (product.ApprovalStatus == "Approved"
                                        && auction != null)
                                    {
                                        if (auction.ApprovalStatus != "Approved")
                                        {
                                            status = auction.ApprovalStatus;
                                        }
                                        else if (auction.StartAt > now)
                                        {
                                            status = "Upcoming";
                                        }
                                        else if (auction.CurrentEndAt > now)
                                        {
                                            status = "Live";
                                        }
                                        else
                                        {
                                            status = auction.Result ?? "Ended";
                                        }
                                    }

                                    <tr>
                                        <td>
                                            @product.Name
                                        </td>

                                        <td>
                                            @if (auction != null)
                                            {
                                                <span>
                                                    $@auction.StartingPrice.ToString("N0")
                                                </span>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>

                                        <td>@bidCount</td>

                                        <td>
                                            @if (auction != null)
                                            {
                                                @auction.CurrentEndAt.ToString("dd/MM/yyyy HH:mm")
                                                <small>UTC</small>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>

                                        <td>
                                            <span class="tag">
                                                @status
                                            </span>
                                        </td>

                                        <td>
                                            <a asp-controller="Selling" asp-action="Details" asp-route-id="@product.ProductId">@Labels["View listing"]</a>
                                            @if (product.ApprovalStatus == "Rejected")
                                            {
                                                <small class="text-danger">@Labels["Product rejected — view reason in listing details."]</small>
                                            }
                                            @if (auction?.ApprovalStatus == "Rejected")
                                            {
                                                <small class="text-danger">@Labels["Auction rejected — view reason in listing details."]</small>
                                            }
                                            @if (auction != null && product.ApprovalStatus == "Approved" && auction.ApprovalStatus == "Approved")
                                            {
                                                <a asp-controller="Auction"
                                                   asp-action="Details"
                                                   asp-route-id="@auction.AuctionId">
                                                    @Labels["View auction"]
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }

                        </tbody>
                    </table>

                </div>

                <div class="callout">
                    @Labels["Open listing details to correct an eligible rejected listing and send it for review again."]
                </div>

            </section>