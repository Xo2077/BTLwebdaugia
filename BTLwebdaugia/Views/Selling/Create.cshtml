@model BTLwebdaugia.ViewModels.CreateProductViewModel

@using BTLwebdaugia.ViewModels

@{
    ViewData["Title"] = "Create Product Listing";
    Layout = "_Layout";

    var categories =
        ViewBag.Categories as IEnumerable<CategoryViewModel>
        ?? Enumerable.Empty<CategoryViewModel>();
}

<div class="container">
    <main class="container">

        <div class="crumb">
            My account / My Selling / Create listing
        </div>

        <div class="page-title">
            <h1>@Labels["Create a product listing"]</h1>
            <p>
                Product must be approved by Admin
                before appearing publicly.
            </p>
        </div>

        <form asp-controller="Product"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data"
              id="create-product-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="auction-detail">

                <section class="panel">

                    <h3>@Labels["Product information"]</h3>

                    <div class="form-group">
                        <label asp-for="Name">
                            Product name
                        </label>

                        <input asp-for="Name"
                               class="field"
                               maxlength="200"
                               placeholder="Enter product name" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CategoryId">
                            @Labels["Category"]
                        </label>

                        <select asp-for="CategoryId"
                                class="field"
                                id="category-select">

                            <option value="0">
                                Select category
                            </option>

                            @foreach (var category in categories)
                            {
                                <option value="@category.CategoryId">
                                    @category.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">
                            @Labels["Description"]
                        </label>

                        <textarea asp-for="Description"
                                  id="product-description"
                                  class="field"
                                  placeholder="Describe the product"
                                  rows="5"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="StartingPrice">
                            Starting price (minimum $50)
                        </label>

                        <input asp-for="StartingPrice"
                               class="field"
                               type="number"
                               min="50"
                               max="999999999999999999"
                               step="1" />

                        <span asp-validation-for="StartingPrice"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="BidStep">
                            Minimum bid increment
                        </label>

                        <input asp-for="BidStep"
                               class="field"
                               type="number"
                               min="1"
                               step="1" />

                        <span asp-validation-for="BidStep"
                              class="text-danger"></span>
                    </div>

                    <h3>@Labels["Auction schedule"]</h3>

                    <p class="muted">@Labels["All auctions require Admin approval."]</p>

                    <div class="form-group">

                        <label asp-for="ScheduledStartAt">
                            @Labels["Scheduled start time (Vietnam time, UTC+7)"]
                        </label>

                        <input asp-for="ScheduledStartAt"
                               class="field"
                               type="datetime-local" />

                        <span asp-validation-for="ScheduledStartAt"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="EndTimeMode">
                            @Labels["End mode"]
                        </label>

                        <select asp-for="EndTimeMode"
                                class="field"
                                id="end-time-mode">

                            <option value="Duration">
                                Duration (1 minute–30 days)
                            </option>

                            <option value="Specific">
                                Specific end date/time
                            </option>

                        </select>

                        <span asp-validation-for="EndTimeMode"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group"
                         id="duration-group">

                        <label asp-for="DurationMinutes">
                            @Labels["Duration (minutes)"]
                        </label>

                        <input asp-for="DurationMinutes"
                               class="field"
                               type="number"
                               min="1"
                               max="43200"
                               step="1" />
    
                        <span asp-validation-for="DurationMinutes"
                              class="text-danger"></span>
                    </div>

                    <div class="form-group"
                         id="specific-end-group">

                        <label asp-for="SpecificEndAt">
                            @Labels["End date and time (Vietnam time, UTC+7)"]
                        </label>

                        <input asp-for="SpecificEndAt"
                               class="field"
                               type="datetime-local" />

                        <span asp-validation-for="SpecificEndAt"
                              class="text-danger"></span>
                    </div>

                    <p class="notice">
                        Approved product details cannot be edited.
                        Rejected drafts may be corrected and resubmitted.
                    </p>

                </section>

                <aside>


                    <h3>@Labels["Product images"]</h3>

                    <div class="form-group">
                        <label asp-for="Images">
                            Select product photos
                        </label>

                        <input asp-for="Images"
                               type="file"
                               accept=".jpg,.jpeg,.png,.webp,.gif,.bmp,.avif"
                               multiple
                               class="field" />

                        <span asp-validation-for="Images"
                              class="text-danger"></span>

                        <p class="muted small">
                            JPG, PNG, WebP, GIF, BMP or AVIF.
                            Maximum 5 images, 5 MB each.
                        </p>


                    </div>


                    <div class="panel" style="margin-top:22px">

                        <h3>@Labels["Listing summary"]</h3>

                        <p>
                            Check all details before submitting.
                        </p>

                        <button class="btn btn-solid"
                                type="submit">
                            Submit listing
                        </button>

                        <a class="btn"
                           asp-controller="Selling"
                           asp-action="Index">
                            Cancel
                        </a>

                        <p class="notice">
                            Your listing will remain pending
                            until reviewed by Admin.
                        </p>

                    </div>

                </aside>

            </div>

        </form>

    </main>
</div>

@section Scripts {
    
    <script src="https://cdn.jsdelivr.net/npm/easymde@2.21.0/dist/easymde.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const textarea =
                document.getElementById("product-description");

            const form =
                document.getElementById("create-product-form");

            if (!textarea || !form || typeof EasyMDE === "undefined")
                return;

            const editor = new EasyMDE({
                element: textarea,
                spellChecker: false,
                status: false,
                autoDownloadFontAwesome: false,
                toolbar: [
                    "bold",
                    "italic",
                    "heading",
                    "|",
                    "quote",
                    "unordered-list",
                    "ordered-list",
                    "|",
                    "link",
                    "preview",
                    "guide"
                ]
            });

            // Đồng bộ nội dung editor với textarea trước POST.
            form.addEventListener("submit", function () {
                editor.codemirror.save();
            });
        });
    </script>







    <script>
        (function () {
            const form = document.getElementById(
                "create-product-form"
            );

            if (!form) return;

            const endMode = document.getElementById(
                "end-time-mode"
            );

            const durationGroup = document.getElementById(
                "duration-group"
            );

            const specificEndGroup = document.getElementById(
                "specific-end-group"
            );

            function updateEndMode() {
                const isDuration =
                    endMode.value === "Duration";

                durationGroup.hidden = !isDuration;
                specificEndGroup.hidden = isDuration;
            }

            endMode.addEventListener(
                "change",
                updateEndMode
            );

            updateEndMode();
        })();
    </script>
}
