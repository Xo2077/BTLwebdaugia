
@{
    ViewData["Title"] = "Create Product Listing";
    Layout = "_Layout";
}

<div class="container">

    <main class="container">
        <div class="crumb">My account / My Selling / Create listing</div>
        <div class="page-title">
            <h1>Create a product listing</h1>
            <p>Product must be approved by Admin before appearing publicly.</p>
        </div>
        <div class="auction-detail">
            <section class="panel">
                <h3>Product information</h3>
                <div class="form-group"><label>Product name</label><input class="field"
                        placeholder="Enter product name" /></div>
                <div class="form-group"><label>Category</label><select class="field" id="category-select">
                        <option value="">Select category</option>
                        <option value="Luxury &amp; Jewelry">Luxury &amp; Jewelry</option>
                        <option value="Motors &amp; Vehicles">Motors &amp; Vehicles</option>
                        <option value="Fine Art">Fine Art</option>
                        <option value="Premium Electronics">Premium Electronics</option>
                        <option value="Designer Fashion">Designer Fashion</option>
                        <option value="Collectibles">Collectibles</option>
                        <option value="Real Estate">Real Estate</option>
                        <option value="Home &amp; Sports">Home &amp; Sports</option>
                    </select></div>
                <div class="form-group"><label>Description</label><textarea class="field"
                        placeholder="Describe the product" rows="5"></textarea></div>
                <div class="form-group"><label>Starting price (minimum $50)</label><input class="field" min="50"
                        type="number" value="100" /></div>
                <div class="form-group"><label>Minimum bid increment (suggested 2% of starting price)</label><input
                        class="field" step="1" type="number" value="2" /></div>
                <h3>Auction schedule</h3><label><input checked="" name="start-mode" type="radio" /> Start after Admin
                    approval</label>
                <p><label><input name="start-mode" type="radio" /> Schedule for a future time</label></p><input
                    class="field" type="datetime-local" />
                <div class="form-group"><label>End mode</label><select class="field">
                        <option>Duration (1 hour–30 days)</option>
                        <option>Specific end date/time</option>
                    </select></div><input class="field" type="datetime-local" />
                <p class="notice">Approved product details cannot be edited. Rejected drafts may be corrected and
                    resubmitted.</p>
            </section>
            <aside>
                <div class="panel">
                    <h3>Product images</h3>
                    <div aria-label="PRODUCT IMAGE" class="image-box" role="img">PRODUCT IMAGE</div>
                    <div class="form-group"><label>Upload photos</label><input accept="image/*" class="field"
                            multiple="" type="file" /></div>
                </div>
                <div class="panel" style="margin-top:22px">
                    <h3>Listing summary</h3>
                    <p>Check all details before publishing.</p><button class="btn" data-demo-action="Save draft">Save
                        draft</button> <button class="btn btn-solid" data-demo-action="Submit for approval">Submit
                        listing</button>
                    <p class="notice" id="action-feedback"></p>
                </div>
            </aside>
        </div>
    </main>

</div>
