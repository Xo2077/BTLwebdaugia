
@model BTLwebdaugia.ViewModels.AuctionDetailViewModel

@{
    ViewData["Title"] = Model.ProductName;
    Layout = "_Layout";

    var now = DateTime.UtcNow;
    bool isLive = Model.AuctionStatus == "Live";

    long secondsRemaining = Math.Max(
        0,
        (long)(Model.CurrentEndAt - now).TotalSeconds
    );
}

<div class="container auction-page">
        <div class="crumb">
            Home / Auction / @Model.CategoryName
        </div>

        <div class="auction-status-row">
            <span class="tag">@Labels[Model.AuctionStatus]</span>
                @if (Model.AuctionStatus == "Live")
                {
                    <p>
                        @Labels["Ends in:"]
                        <strong class="countdown"
                                data-seconds="@secondsRemaining">
                            Calculating...
                        </strong>
                    </p>
                }
                else if (Model.AuctionStatus == "Upcoming")
                {
                    <p class="muted">
                        @Labels["Starts at:"]
                        @Model.StartAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                        UTC+7
                    </p>
                }
                else
                {
                    <p class="muted">
                        @Labels["Auction ended:"]
                        @Model.CurrentEndAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                        UTC+7
                    </p>
                }


        </div>

                <div class="panel bid-history" id="auction-history">

                    <h3>@Labels["Latest bids"]</h3>

                    @if (!Model.RecentBids.Any())
                    {
                        <p class="muted">
                            @Labels["No bids have been placed yet."]
                        </p>
                    }
                    else
                    {
                        <ol class="bid-ranks">
                            @foreach (var bid in Model.RecentBids.Take(3))
                            {
                                <li>
                                    <span>
                                        @if (!string.IsNullOrWhiteSpace(bid.AvatarPath))
                                        {
                                            <img class="bid-rank-avatar" src="@bid.AvatarPath" alt="" />
                                        }
                                        else
                                        {
                                            <span class="bid-rank-avatar bid-rank-placeholder" aria-hidden="true">@bid.BidderName.FirstOrDefault()</span>
                                        }
                                        @bid.BidderName
                                    </span>

                                    <strong>
                                        $@bid.Amount.ToString("N0")
                                    </strong>
                                </li>
                            }
                        </ol>
                    }

                </div>

        <div class="auction-overview">
        <div class="page-title">

            <h1>@Model.ProductName</h1>

            <p>by @Model.SellerName</p>

        </div>
            <div class="auction-gallery">
                @if (Model.ImagePaths.Any())
                {
                    <div class="image-box gallery-main auction-image-frame">
                        <img src="@Model.ImagePaths.First()"
                             alt="@Model.ProductName"
                             class="auction-product-image"
                             loading="eager" />
                    </div>


                    <div class="thumbs">
                        @foreach (var image in Model.ImagePaths.Skip(1))
                        {
                            <div class="image-box">
                                <img src="@image"
                                     alt="@Model.ProductName"
                                     loading="lazy"
                                     style="width:100%;height:100%;object-fit:cover;" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="image-box gallery-main auction-image-frame">
                        Not available
                    </div>
                }
            </div>
            <div class="panel bid-panel" id="auction-bid-panel">

                <p class="muted">
                    @(Model.RecentBids.Any()
                        ? "Current highest bid"
                        : "Starting price")
                </p>

                <div class="price">
                    $@Model.CurrentPrice.ToString("N0")
                </div>

                <hr />

                <p>
                    @Labels["Minimum bid increment:"]
                    <strong>
                        $@Model.BidStep.ToString("N0")
                    </strong>
                </p>

                <p>
                    @Labels["Minimum next bid:"]
                    <strong>
                        $@Model.NextMinimumBid.ToString("N0")
                    </strong>
                </p>


                @if (isLive)
                {

                    @if (TempData["BidError"] != null)
                    {
                        <p class="notice text-danger">
                            @TempData["BidError"]
                        </p>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form id="auction-bid-form" asp-controller="Bidding"
                              asp-action="PlaceBid"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="AuctionId"
                                   value="@Model.AuctionId" />

                            <div class="form-group">
                                <label for="bid-value">
                                    @Labels["Enter your bid (whole USD)"]
                                </label>

                                <input class="field"
                                       id="bid-value"
                                       name="Amount"
                                       type="number"
                                       min="@Model.NextMinimumBid"
                                       max="999999999999999999"
                                       step="1"
                                       value="@Model.NextMinimumBid"
                                       required />
                            </div>

                            <button class="btn btn-solid btn-wide"
                                    type="submit">
                                @Labels["Place Bid"]
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="notice">
                            Please sign in to place a bid.
                        </p>

                        <a class="btn btn-solid btn-wide"
                           asp-controller="Account"
                           asp-action="SignIn">
                            @Labels["Sign in"]
                        </a>
                    }
                }

                else if (Model.AuctionStatus == "Upcoming")
                {
                    <p class="notice">
                        This auction has not started yet.
                        Bidding is unavailable.
                    </p>
                }
                else
                {
                    <p class="notice">
                        This auction has ended.
                        New bids are no longer accepted.
                    </p>
                }

                <p class="muted small">
                    Auction ID: @Model.AuctionId
                </p>

            </div>
        </div>

        <details class="desc-section panel">

            <summary>@Labels["Item Description"]</summary>

            <p>@Model.Description</p>

            <h3>@Labels["Item Details"]</h3>

            <p>
                Category:
                <strong>@Model.CategoryName</strong>
            </p>

            <p>
                Seller:
                <strong>@Model.SellerName</strong>
            </p>

            <p>
                @Labels["Starting price:"]
                <strong>
                    $@Model.StartingPrice.ToString("N0")
                </strong>
            </p>

            <p>
                @Labels["Start time:"]
                @Model.StartAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                UTC+7
            </p>

            <p>
                @Labels["End time:"]
                @Model.CurrentEndAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                UTC+7
            </p>

        </details>
</div>


@section Scripts {
    <script src="~/js/auction-bids.js" asp-append-version="true"></script>
}