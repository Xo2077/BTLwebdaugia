
@{
    ViewData["Title"] = "Ended Auction";
    Layout = "_Layout";
}

<div class="container">

    <div class="crumb">
        Home / End Auction / Product
    </div>

    <h1>Vintage camera</h1>

    <div class="auction-detail">

        <div>
            <div class="image-box"
                 role="img"
                 aria-label="PRODUCT IMAGE">
                PRODUCT IMAGE
            </div>
        </div>

        <div class="panel">

            <span class="tag">Sold</span>

            <h2>Auction ended</h2>

            <p>
                Starting price:
                <strong>$150</strong>
            </p>

            <p>
                Final bid:
                <strong>$450</strong>
            </p>

            <p>
                Ended: 20/10/2026 – 14:30 (UTC+7)
            </p>

            <p>
                Winner username:
                <strong>Bidder_01</strong>
            </p>

            <p class="muted">
                Bid history is not displayed
                for ended auctions.
            </p>

        </div>

    </div>

</div>
