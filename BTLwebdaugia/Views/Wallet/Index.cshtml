@model BTLwebdaugia.ViewModels.WalletViewModel

@{
    ViewData["Title"] = Labels["My Wallet"].Value;
    Layout = "_Layout";
}

<div class="container">

    @await Html.PartialAsync("_AccountBreadcrumb", "My Wallet")

    <div class="account" data-account-page="wallet">

        @await Component.InvokeAsync("AccountSidebar")

        <div id="account-content">
            @await Html.PartialAsync("_WalletContent", Model)
        </div>

    </div>

</div>
