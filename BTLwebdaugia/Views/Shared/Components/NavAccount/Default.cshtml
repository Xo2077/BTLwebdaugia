@model BTLwebdaugia.Services.AccountDisplay?

@if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin"
                           asp-action="Index">
                            Admin
                        </a>
                    }


                    <a asp-controller="Account"
                       asp-action="Profile">
                        @(Model?.Username ?? User.Identity?.Name ?? "My account")
                    </a>


                    <div class="notification-dropdown" data-error="@Labels["Unable to open notification. Please try again."]" data-list-url="@Url.Action("List", "Notifications")">
                        <button type="button" id="notification-toggle" class="notification-toggle"
                                aria-label="@Labels["Notifications"]" aria-expanded="false" aria-controls="notification-menu">
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                                <path d="M10 21h4" />
                            </svg>
                            <span id="notification-count" hidden></span>
                        </button>
                        <div id="notification-menu" hidden>
                            @await Component.InvokeAsync("Notifications")
                        </div>
                    </div>

                    <div class="nav-avatar-dropdown">

                        <button type="button"
                                class="nav-avatar-button"
                                id="nav-avatar-toggle"
                                aria-label="Account menu"
                                aria-expanded="false"
                                aria-controls="nav-avatar-menu">

                            @if (!string.IsNullOrWhiteSpace(Model?.AvatarPath))
                            {
                                <img src="@Model?.AvatarPath"
                                     alt="My avatar"
                                     class="nav-avatar-image" />
                            }
                            else
                            {
                                <span class="nav-avatar-placeholder">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="23"
                                         height="23"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <circle cx="12" cy="8" r="4" />
                                        <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
                                    </svg>
                                </span>
                            }

                        </button>

                        <div class="nav-avatar-menu"
                             id="nav-avatar-menu"
                             hidden>

                            <a asp-controller="Account"
                               asp-action="Profile"
                               class="nav-avatar-menu-item">
                                @Labels["My Profile"]
                            </a>

                            <form asp-controller="Account"
                                  asp-action="LogOut"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="nav-avatar-logout">
                                    @Labels["Sign out"]
                                </button>
                            </form>

                        </div>

                    </div>

                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="SignIn">
                        @Labels["Sign in"]
                    </a>
                }
