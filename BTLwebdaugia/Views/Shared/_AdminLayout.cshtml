
@{
    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="BidHub Admin Dashboard" />

    <title>@ViewData["Title"] | BidHub Admin</title>

    <link rel="stylesheet"
          href="~/css/style.css"
          asp-append-version="true" />
</head>
<body>


    <header class="site-header">
        <div class="container nav-inner">

            <a class="brand" href="/">
                <img class="brand-logo" src="~/assets/bidhub-logo.png" asp-append-version="true" alt="BidHub" width="180" height="55" />
            </a>

            <button class="nav-toggle"
                    type="button"
                    aria-label="Toggle navigation">
                ☰
            </button>

            <nav class="nav-links">


                <a asp-controller="Home" asp-action="Index">@Labels["Home"]</a>


                <a href="/Home/Category">@Labels["Category"]</a>
                <a aria-disabled="true">@Labels["About Us"]</a>
                <a aria-disabled="true">@Labels["Contact"]</a>
            </nav>

            <div class="nav-actions">
                <partial name="_LanguageSwitch" />
                @await Component.InvokeAsync("NavAccount")

            </div>

        </div>
    </header>

    <p id="admin-feedback" role="status" hidden
       data-loading="@Labels["Loading admin data..."]"
       data-error="@Labels["Unable to complete this action. Please try again."]"
       data-access="@Labels["Your session has expired or access was denied."]"></p>
    <main class="admin-layout">

        <aside class="admin-sidebar">


            <a class="@(currentAction == "Index" ? "active" : "")"
               asp-controller="Admin"
               asp-action="Index">
                @Labels["Dashboard"]
            </a>

            <a class="@(currentAction == "Users" ? "active" : "")"
               asp-controller="Admin"
               asp-action="Users">
                @Labels["Users"]
            </a>

            <a class="@(currentAction == "Categories" ? "active" : "")"
               asp-controller="Admin"
               asp-action="Categories">
                @Labels["Categories"]
            </a>


            <a class="@(currentAction == "Products" ? "active" : "")"
               asp-controller="Admin"
               asp-action="Products">
                @Labels["Products"]
            </a>

            <a class="@(currentAction == "Auctions" ? "active" : "")"
               asp-controller="Admin"
               asp-action="Auctions">
                @Labels["Auctions"]
            </a>

            <a class="@(currentAction == "Bids" ? "active" : "")"
               asp-controller="Admin"
               asp-action="Bids">
                @Labels["BIDS"]
            </a>

            <a class="@(currentAction == "Orders" ? "active" : "")"
               asp-controller="Admin"
               asp-action="Orders">
                @Labels["Orders"]
            </a>

            <a class="@(currentAction == "Wallets" ? "active" : "")"
               asp-controller="Admin"
               asp-action="Wallets">
                @Labels["Wallets"]
            </a>
        </aside>

        <div class="admin-content" id="admin-content">
            @RenderBody()
        </div>

    </main>

    <footer class="footer">
        <div class="container">

            <div class="footer-top">
                <a class="brand" href="/">
                    <img class="brand-logo" src="~/assets/bidhub-logo.png" asp-append-version="true" alt="BidHub" width="180" height="55" />
                </a>

                <div class="footer-links">
                    <a asp-controller="Home" asp-action="Privacy">@Labels["Privacy"]</a>
                </div>
            </div>


            <div class="footer-bottom">
                © 2026 Bidhub. All rights reserved.
            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/app.js"
            asp-append-version="true"></script>

    <script src="~/js/enhancements.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="~/js/nav-account.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
</body>
</html>
