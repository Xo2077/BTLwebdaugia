@model ErrorViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Labels["Error"] | BidHub</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <main class="container">
        <h1>@Labels["Error"]</h1>
        <p>@Labels["An error occurred while processing your request."]</p>
        @if (Model.ShowRequestId)
        {
            <p>@Labels["Request ID:"] <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Home" asp-action="Index">@Labels["Home"]</a>
    </main>
</body>
</html>
