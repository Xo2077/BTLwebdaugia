@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject BTLwebdaugia.Data.BidHubDbContext DbContext

@{
    string? navAvatarPath = null;

    if (User.Identity?.IsAuthenticated == true &&
        long.TryParse(
            User.FindFirstValue(ClaimTypes.NameIdentifier),
            out long currentUserId))
    {
        navAvatarPath = await DbContext.UserImages
            .AsNoTracking()
            .Where(x => x.UserId == currentUserId)
            .Select(x => x.ImagePath)
            .FirstOrDefaultAsync();
    }
}





<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="BidHub auction platform" />

    <title>@ViewData["Title"] | BidHub</title>

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde@2.21.0/dist/easymde.min.css" />
</head>
<body>


    <header class="site-header">
        <div class="container nav-inner">

            <a class="brand" href="/">
                <span class="brand-mark">⚒</span>
                <span>BidHub</span>
            </a>

            <button class="nav-toggle" type="button" aria-label="Toggle navigation">
                ☰
            </button>

            <nav class="nav-links">

                <a asp-controller="Home" asp-action="Index">Home</a>


                <a asp-controller="Home" asp-action="Category">Category</a>

                <a href="#">About Us</a>
                <a href="#">Contact</a>
            </nav>


            <div class="nav-actions">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin"
                           asp-action="Index">
                            Admin
                        </a>
                    }

                    <a asp-controller="Wallet"
                       asp-action="Index">♡</a>

                    <a asp-controller="Account"
                       asp-action="Profile">
                        My account
                    </a>


                    <div class="nav-avatar-dropdown">

                        <button type="button"
                                class="nav-avatar-button"
                                id="nav-avatar-toggle"
                                aria-label="Account menu"
                                aria-expanded="false"
                                aria-controls="nav-avatar-menu">

                            @if (!string.IsNullOrWhiteSpace(navAvatarPath))
                            {
                                <img src="@navAvatarPath"
                                     alt="My avatar"
                                     class="nav-avatar-image" />
                            }
                            else
                            {
                                <span class="nav-avatar-placeholder">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="23"
                                         height="23"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <circle cx="12" cy="8" r="4" />
                                        <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
                                    </svg>
                                </span>
                            }

                        </button>

                        <div class="nav-avatar-menu"
                             id="nav-avatar-menu"
                             hidden>

                            <a asp-controller="Account"
                               asp-action="Profile"
                               class="nav-avatar-menu-item">
                                My Profile
                            </a>

                            <form asp-controller="Account"
                                  asp-action="LogOut"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="nav-avatar-logout">
                                    Sign out
                                </button>
                            </form>

                        </div>

                    </div>

                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="SignIn">
                        Sign in
                    </a>
                }

            </div>


        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">

            <div class="footer-top">

                <a class="brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-mark">⚒</span>
                    <span>BidHub</span>
                </a>


                <div class="footer-links">
                    <a href="#">About Us</a>
                    <a href="#">Terms</a>
                    <a href="#">Policy</a>
                    <a href="#">Contact</a>
                </div>
            </div>

            <div class="socials">
                <span>f</span>
                <span>◎</span>
                <span>▶</span>
            </div>

            <div class="footer-bottom">
                © 2026 Bidhub. All rights reserved.
            </div>

        </div>
    </footer>

    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/enhancements.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const toggle = document.getElementById("nav-avatar-toggle");
            const menu = document.getElementById("nav-avatar-menu");

            if (!toggle || !menu) return;

            toggle.addEventListener("click", function (event) {
                event.stopPropagation();

                menu.hidden = !menu.hidden;

                toggle.setAttribute(
                    "aria-expanded",
                    String(!menu.hidden)
                );
            });

            document.addEventListener("click", function (event) {
                if (!event.target.closest(".nav-avatar-dropdown")) {
                    menu.hidden = true;
                    toggle.setAttribute("aria-expanded", "false");
                }
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    menu.hidden = true;
                    toggle.setAttribute("aria-expanded", "false");
                    toggle.focus();
                }
            });

        });
    </script>

</body>
</html>
