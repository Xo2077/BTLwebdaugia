@inject BTLwebdaugia.Services.AccountDisplayService AccountDisplay
@{
    var navAvatarPath = (await AccountDisplay.GetAsync(User))?.AvatarPath;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="BidHub auction platform" />

    <title>@ViewData["Title"] | BidHub</title>

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde@2.21.0/dist/easymde.min.css" />
</head>
<body>


    <header class="site-header">
        <div class="container nav-inner">

            <a class="brand" href="/">
                <img class="brand-logo" src="~/assets/bidhub-logo.png" asp-append-version="true" alt="BidHub" width="180" height="55" />
            </a>

            <button class="nav-toggle" type="button" aria-label="Toggle navigation">
                ☰
            </button>

            <nav class="nav-links">

                <a asp-controller="Home" asp-action="Index">@Labels["Home"]</a>


                <a asp-controller="Home" asp-action="Category">@Labels["Category"]</a>

            </nav>


            <div class="nav-actions">
                <partial name="_LanguageSwitch" />

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin"
                           asp-action="Index">
                            Admin
                        </a>
                    }


                    <a asp-controller="Account"
                       asp-action="Profile">
                        @(User.Identity?.Name ?? "My account")
                    </a>


                    <div class="nav-avatar-dropdown">

                        <button type="button"
                                class="nav-avatar-button"
                                id="nav-avatar-toggle"
                                aria-label="Account menu"
                                aria-expanded="false"
                                aria-controls="nav-avatar-menu">

                            @if (!string.IsNullOrWhiteSpace(navAvatarPath))
                            {
                                <img src="@navAvatarPath"
                                     alt="My avatar"
                                     class="nav-avatar-image" />
                            }
                            else
                            {
                                <span class="nav-avatar-placeholder">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="23"
                                         height="23"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.8"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <circle cx="12" cy="8" r="4" />
                                        <path d="M4 21v-2a8 8 0 0 1 16 0v2" />
                                    </svg>
                                </span>
                            }

                        </button>

                        <div class="nav-avatar-menu"
                             id="nav-avatar-menu"
                             hidden>

                            <a asp-controller="Account"
                               asp-action="Profile"
                               class="nav-avatar-menu-item">
                                @Labels["My Profile"]
                            </a>

                            <form asp-controller="Account"
                                  asp-action="LogOut"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="nav-avatar-logout">
                                    @Labels["Sign out"]
                                </button>
                            </form>

                        </div>

                    </div>

                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="SignIn">
                        @Labels["Sign in"]
                    </a>
                }

            </div>


        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">

            <div class="footer-top">

                <a class="brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <img class="brand-logo" src="~/assets/bidhub-logo.png" asp-append-version="true" alt="BidHub" width="180" height="55" />
                </a>


                <div class="footer-links">
                    <a asp-controller="Home" asp-action="Privacy">@Labels["Privacy"]</a>
                </div>
            </div>


            <div class="footer-bottom">
                © 2026 Bidhub. All rights reserved.
            </div>

        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"
            asp-append-version="true"></script>

    <script src="~/js/app.js"
            asp-append-version="true"></script>

    <script src="~/js/enhancements.js"
            asp-append-version="true"></script>

    <script src="~/js/account-ajax.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const toggle = document.getElementById("nav-avatar-toggle");
            const menu = document.getElementById("nav-avatar-menu");

            if (!toggle || !menu) return;

            toggle.addEventListener("click", function (event) {
                event.stopPropagation();

                menu.hidden = !menu.hidden;

                toggle.setAttribute(
                    "aria-expanded",
                    String(!menu.hidden)
                );
            });

            document.addEventListener("click", function (event) {
                if (!event.target.closest(".nav-avatar-dropdown")) {
                    menu.hidden = true;
                    toggle.setAttribute("aria-expanded", "false");
                }
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    menu.hidden = true;
                    toggle.setAttribute("aria-expanded", "false");
                    toggle.focus();
                }
            });

        });
    </script>

</body>
</html>
