<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="BidHub auction platform" />

    <title>@ViewData["Title"] | BidHub</title>

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>


    <header class="site-header">
        <div class="container nav-inner">

            <a class="brand" href="/">
                <img class="brand-logo" src="~/assets/bidhub-logo.png" asp-append-version="true" alt="BidHub" width="180" height="55" />
            </a>

            <button class="nav-toggle" type="button" aria-label="Toggle navigation">
                ☰
            </button>

            <nav class="nav-links">

                <a asp-controller="Home" asp-action="Index">@Labels["Home"]</a>


                <a asp-controller="Home" asp-action="Category">@Labels["Category"]</a>
                <a aria-disabled="true">@Labels["About Us"]</a>
                <a aria-disabled="true">@Labels["Contact"]</a>

            </nav>


            <div class="nav-actions">
                <partial name="_LanguageSwitch" />

                @await Component.InvokeAsync("NavAccount")

            </div>


        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">

            <div class="footer-top">

                <a class="brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <img class="brand-logo" src="~/assets/bidhub-logo.png" asp-append-version="true" alt="BidHub" width="180" height="55" />
                </a>


                <div class="footer-links">
                    <a asp-controller="Home" asp-action="Privacy">@Labels["Privacy"]</a>
                </div>
            </div>


            <div class="footer-bottom">
                © 2026 Bidhub. All rights reserved.
            </div>

        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"
            asp-append-version="true"></script>

    <script src="~/js/app.js"
            asp-append-version="true"></script>

    <script src="~/js/enhancements.js"
            asp-append-version="true"></script>

    <script src="~/js/account-ajax.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script src="~/js/nav-account.js" asp-append-version="true"></script>

    <script src="~/js/notifications.js" asp-append-version="true"></script>
</body>
</html>
