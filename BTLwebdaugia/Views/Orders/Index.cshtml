@model List<BTLwebdaugia.Models.Order>



@{
    ViewData["Title"] = Labels["My Orders"].Value;
    Layout = "_Layout";

}

<div class="container">

    <div class="crumb">
        Home / My account / My Orders
    </div>

    <div class="account" data-account-page="orders">

        @await Html.PartialAsync("_AccountSidebar")

        <div id="account-content">
            @await Html.PartialAsync("_OrdersContent", Model)
        </div>

    </div>

</div>
